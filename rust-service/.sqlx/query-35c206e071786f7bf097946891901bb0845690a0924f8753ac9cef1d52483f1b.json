{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT DISTINCT q.id, q.item_id, q.type as question_type\n        FROM questions q\n        INNER JOIN items i ON i.id = q.item_id\n        INNER JOIN exam_item ei ON ei.item_id = i.id\n        WHERE ei.exam_id = $1\n        ORDER BY q.id\n        ",
